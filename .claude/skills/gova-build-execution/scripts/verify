#!/usr/bin/env bash
# verify — restart the app, wait until it answers, and run the test suite.
#
# The one verification path an implementer uses. Tasks run one at a time, so
# there is nothing to serialize against and no failure to classify: a failing
# test is this task's problem.
#
# Usage: verify
# Exit:  0 pass | 1 failure
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "==> restarting app"
docker compose restart app >/dev/null

port=$(grep -E '^APP_PORT=' .env 2>/dev/null | cut -d= -f2)
port=${port:-8080}
for _ in $(seq 1 60); do
  if curl -s -o /dev/null --max-time 2 "http://localhost:${port}/api/v1/_version"; then
    ready=1; break
  fi
  sleep 0.5
done
if [ "${ready:-}" != 1 ]; then
  echo "app did not answer within 30s of restart" >&2
  exit 1
fi

echo "==> go test ./..."
if ! docker compose exec -T app go test ./... 2>&1 | tail -20; then
  echo "TESTS FAILED" >&2
  exit 1
fi

echo "verify passed"
