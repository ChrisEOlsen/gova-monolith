# Secrets and per-machine config
.env
.claude/settings.local.json
.gemini/settings.json
# Generated per machine by install-opencode.sh. Anchored to the repo root on
# purpose: a bare `opencode.json` would also match .opencode/opencode.json,
# which is committed config.
/opencode.json

# Data, logs, build output
data/
logs/
*.db
*.db-shm
*.db-wal
src/app/static/css/style.css
src/builder/gova
src/builder/builder
src/.gova-lock
/tmp/

# Build-time scratch — never committed into an app.
#
# .gova-build/ is the gova-build-execution skill's working directory: task
# briefs, per-task reports, review diffs. A record of HOW a build was carried
# out, useful while it runs and noise afterwards. It was not ignored before,
# which is how a 20KB report about fixing the template ended up committed and
# shipping into every project scaffolded from this repo.
.gova-build/
.security/

# Notes about developing THIS repo rather than an app built with it. A derived
# project inherits every tracked file, and an AI opening that project reads
# them as its own history — spending context on, and sometimes reasoning from,
# decisions that belong to somebody else's codebase.
docs/gova-monolith-history/
