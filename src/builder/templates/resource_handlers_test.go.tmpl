// Test{{.PascalName}}ResourceOwnerIsolation drives the same routes as another
// signed-in user. Every one of them must answer as though the row does not
// exist — a 403 would confirm the id, and a 200 would be the bug this whole
// option exists to prevent.
func Test{{.PascalName}}ResourceOwnerIsolation(t *testing.T) {
	testDB := db.OpenTest(t, {{.Name}}ResourceSchema())
	appCache := cache.New()
	router := {{.Name}}Router(testDB, appCache)
	model := models.New{{.PascalName}}Model(testDB, appCache)
	owner, other := seed{{.PascalName}}Users(t, testDB)

{{testDecls .Fields "\t" "models."}}	id, err := model.Create(owner, {{testArgs .Fields "models."}})
	if err != nil {
		t.Fatalf("seed Create: %v", err)
	}

	do := func(userID int64, method, target, body string) *httptest.ResponseRecorder {
		var r *http.Request
		if body == "" {
			r = httptest.NewRequest(method, target, nil)
		} else {
			r = httptest.NewRequest(method, target, strings.NewReader(body))
		}
		rec := httptest.NewRecorder()
		router.ServeHTTP(rec, as{{.PascalName}}User(r, userID))
		return rec
	}

	// Warm the list cache as the owner first: a cache key that ignored the
	// owner would hand the owner's rows to the next caller.
	if rec := do(owner, http.MethodGet, "/api/v1/{{.PluralName}}", ""); rec.Code != 200 {
		t.Fatalf("list as owner: got %d", rec.Code)
	}
	if rec := do(other, http.MethodGet, "/api/v1/{{.PluralName}}", ""); rec.Code != 200 || !strings.Contains(rec.Body.String(), `"total":0`) {
		t.Errorf("list as non-owner: want 200 with total 0, got %d, body %s", rec.Code, rec.Body.String())
	}

	target := "/api/v1/{{.PluralName}}/1"
	if rec := do(other, http.MethodGet, target, ""); rec.Code != 404 {
		t.Errorf("detail as non-owner: got %d, want 404", rec.Code)
	}
	if rec := do(other, http.MethodPut, target, `{{testJSON .Fields}}`); rec.Code != 404 {
		t.Errorf("update as non-owner: got %d, want 404", rec.Code)
	}
	if rec := do(other, http.MethodDelete, target, ""); rec.Code != 404 {
		t.Errorf("delete as non-owner: got %d, want 404", rec.Code)
	}

	// The row is untouched.
	if _, err := model.Find(id, owner); err != nil {
		t.Errorf("owner's row did not survive the non-owner's requests: %v", err)
	}
}
