package handlers

import (
	"database/sql"
	"errors"
	"net/http"
	"strconv"
	"strings"

	"github.com/go-chi/chi/v5"
	"gova/app/cache"
	"gova/app/db"
{{- if .Owned}}
	"gova/app/middleware"
{{- end}}
	"gova/app/models"
)

{{if .Owned}}// {{.Name}}Request is what a client may set. {{ownerColumn}} is deliberately
// absent: the owner comes from the session, so there is no field for a client
// to put someone else's id into.
{{end}}type {{.Name}}Request struct {
	{{- range .Fields}}
	{{toPascal .Name}} {{goFieldTypeQualified .}} `json:"{{.Name}}"`
	{{- end}}
}

func parse{{.PascalName}}ID(r *http.Request) (int64, error) {
	return strconv.ParseInt(chi.URLParam(r, "id"), 10, 64)
}
{{if .Owned}}
// owner{{.PascalName}} is the user every query below is scoped to. The route
// carries middleware.RequireAuth (auth:true in api.json), so by the time a
// handler runs this is a real user id — reading it is not a second auth check,
// it is the parameter the model needs.
func owner{{.PascalName}}(r *http.Request) int64 {
	return middleware.UserID(r)
}
{{end}}

// {{.PascalName}}ListGET handles GET /api/v1/{{.PluralName}}
// Query: ?limit=<1..200>&offset=<0..>&sort=<[-]col>&filter=<col:value>
func {{.PascalName}}ListGET(database *db.DB, appCache *cache.Cache) http.HandlerFunc {
	model := models.New{{.PascalName}}Model(database, appCache)
	return func(w http.ResponseWriter, r *http.Request) {
		limit := queryInt(r, "limit", defaultPageLimit, 1, maxPageLimit)
		offset := queryInt(r, "offset", 0, 0, maxPageOffset)
		opts := models.QueryOpts{Sort: r.URL.Query().Get("sort")}
		if f := r.URL.Query().Get("filter"); f != "" {
			if k, v, ok := strings.Cut(f, ":"); ok {
				opts.FilterField, opts.FilterValue = k, v
			}
		}
		items, total, err := model.GetPage({{if .Owned}}owner{{.PascalName}}(r), {{end}}limit, offset, opts)
		if err != nil {
			if errors.Is(err, models.ErrInvalidQuery) {
				jsonError(w, "invalid sort/filter column; allowed: id, {{joinNames .Fields}}, created_at", http.StatusUnprocessableEntity)
				return
			}
			jsonError(w, "failed to load", http.StatusInternalServerError)
			return
		}
		jsonList(w, items, Meta{Limit: limit, Offset: offset, Total: total})
	}
}

// {{.PascalName}}DetailGET handles GET /api/v1/{{.PluralName}}/{id}
func {{.PascalName}}DetailGET(database *db.DB, appCache *cache.Cache) http.HandlerFunc {
	model := models.New{{.PascalName}}Model(database, appCache)
	return func(w http.ResponseWriter, r *http.Request) {
		id, err := parse{{.PascalName}}ID(r)
		if err != nil {
			jsonError(w, "invalid id", http.StatusUnprocessableEntity)
			return
		}
		item, err := model.Find(id{{if .Owned}}, owner{{.PascalName}}(r){{end}})
		if err != nil {
			if errors.Is(err, sql.ErrNoRows) {
				// 404 for a row that belongs to someone else, exactly as for a
				// row that does not exist. A 403 here would confirm the id.
				jsonError(w, "not found", http.StatusNotFound)
				return
			}
			jsonError(w, "failed to load", http.StatusInternalServerError)
			return
		}
		jsonOK(w, item)
	}
}

// {{.PascalName}}CreatePOST handles POST /api/v1/{{.PluralName}}
func {{.PascalName}}CreatePOST(database *db.DB, appCache *cache.Cache) http.HandlerFunc {
	model := models.New{{.PascalName}}Model(database, appCache)
	return func(w http.ResponseWriter, r *http.Request) {
		var req {{.Name}}Request
		if !readJSON(w, r, &req) {
			return
		}
		id, err := model.Create({{if .Owned}}owner{{.PascalName}}(r), {{end}}{{structCallArgs .Fields "req."}})
		if err != nil {
			jsonError(w, "failed to create", http.StatusInternalServerError)
			return
		}
		item, err := model.Find(id{{if .Owned}}, owner{{.PascalName}}(r){{end}})
		if err != nil {
			jsonError(w, "created but failed to load", http.StatusInternalServerError)
			return
		}
		jsonOK(w, item)
	}
}

// {{.PascalName}}UpdatePUT handles PUT /api/v1/{{.PluralName}}/{id}
func {{.PascalName}}UpdatePUT(database *db.DB, appCache *cache.Cache) http.HandlerFunc {
	model := models.New{{.PascalName}}Model(database, appCache)
	return func(w http.ResponseWriter, r *http.Request) {
		id, err := parse{{.PascalName}}ID(r)
		if err != nil {
			jsonError(w, "invalid id", http.StatusUnprocessableEntity)
			return
		}
		var req {{.Name}}Request
		if !readJSON(w, r, &req) {
			return
		}
		if err := model.Update(id{{if .Owned}}, owner{{.PascalName}}(r){{end}}, {{structCallArgs .Fields "req."}}); err != nil {
			if errors.Is(err, sql.ErrNoRows) {
				jsonError(w, "not found", http.StatusNotFound)
				return
			}
			jsonError(w, "failed to update", http.StatusInternalServerError)
			return
		}
		item, err := model.Find(id{{if .Owned}}, owner{{.PascalName}}(r){{end}})
		if err != nil {
			jsonError(w, "updated but failed to load", http.StatusInternalServerError)
			return
		}
		jsonOK(w, item)
	}
}

// {{.PascalName}}DeleteDELETE handles DELETE /api/v1/{{.PluralName}}/{id}
func {{.PascalName}}DeleteDELETE(database *db.DB, appCache *cache.Cache) http.HandlerFunc {
	model := models.New{{.PascalName}}Model(database, appCache)
	return func(w http.ResponseWriter, r *http.Request) {
		id, err := parse{{.PascalName}}ID(r)
		if err != nil {
			jsonError(w, "invalid id", http.StatusUnprocessableEntity)
			return
		}
		if err := model.Delete(id{{if .Owned}}, owner{{.PascalName}}(r){{end}}); err != nil {
			if errors.Is(err, sql.ErrNoRows) {
				jsonError(w, "not found", http.StatusNotFound)
				return
			}
			jsonError(w, "failed to delete", http.StatusInternalServerError)
			return
		}
		jsonOK(w, map[string]bool{"ok": true})
	}
}
