package handlers

import (
	"crypto/rand"
	"crypto/sha256"
	"database/sql"
	"encoding/hex"
	"encoding/json"
	"log"
	"net/http"
	"strings"
	"time"

	"golang.org/x/crypto/bcrypt"
	"gova/app/cache"
	"gova/app/models"
)

// mobileTokenTTL is how long a mobile bearer token stays valid before the
// client must log in again. Expired tokens are rejected on lookup by
// models.MobileTokenModel.
const mobileTokenTTL = 30 * 24 * time.Hour

// MobileLoginPOST handles POST /api/v1/auth/login_token
// Body: { "email": "...", "password": "..." }
// Response: { "ok": true, "data": { "token": "...", "user": { "id": ..., "name": "...", "email": "..." } } }
// Token is a 64-char hex string; only its SHA-256 hash is stored in mobile_tokens.
func MobileLoginPOST(readDB, writeDB *sql.DB, appCache *cache.Cache) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		var body struct {
			Email    string `json:"email"`
			Password string `json:"password"`
		}
		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
			jsonError(w, "invalid request body", http.StatusBadRequest)
			return
		}
		email := strings.TrimSpace(body.Email)
		if email == "" || body.Password == "" {
			jsonError(w, "email and password are required", http.StatusBadRequest)
			return
		}
		// The BEARER login's own bucket. Not a bare clientIP(r): ClearAttempts
		// deletes by key, so sharing a key with the cookie login lets a success
		// on either endpoint erase the other's failures. See auth_buckets.go.
		ip := loginTokenBucket(clientIP(r))

		userModel := models.NewUserModel(readDB, writeDB, appCache)

		// A READ FAILURE IS A 500, NOT A 429.
		//
		// `err != nil || locked` collapsed the two into one answer, so a broken
		// database told every caller "too many attempts, try again in 15
		// minutes" — a specific, false, and self-limiting-sounding claim that
		// sends an operator to look at the rate limiter instead of at the
		// outage. Failing closed is right; lying about why is not.
		locked, err := userModel.IsRateLimited(ip)
		if err != nil {
			log.Printf("handlers: rate-limit read failed for %q: %v", ip, err)
			jsonError(w, "Something went wrong. Try again.", http.StatusInternalServerError)
			return
		}
		if locked {
			jsonError(w, "Too many attempts. Try again in 15 minutes.", http.StatusTooManyRequests)
			return
		}

		user, err := userModel.FindByEmail(email)
		if err != nil {
			// Pay the same bcrypt cost as the wrong-password path below so
			// response time can't be used to enumerate emails.
			bcrypt.CompareHashAndPassword(dummyHash, []byte(body.Password))
			// The limiter's write error is NOT ignorable: a failure here means
			// the attempt was never counted, so the counter never trips and the
			// control is silently off. There is nothing useful to tell the
			// caller — the answer is the same 401 either way — but an operator
			// must be able to see it.
			if err := userModel.RecordFailedAttempt(ip); err != nil {
				log.Printf("handlers: rate limiter failed to record an attempt for %q: %v", ip, err)
			}
			jsonError(w, "invalid email or password", http.StatusUnauthorized)
			return
		}
		if bcrypt.CompareHashAndPassword([]byte(user.PasswordHash), []byte(body.Password)) != nil {
			// The limiter's write error is NOT ignorable: a failure here means
			// the attempt was never counted, so the counter never trips and the
			// control is silently off. There is nothing useful to tell the
			// caller — the answer is the same 401 either way — but an operator
			// must be able to see it.
			if err := userModel.RecordFailedAttempt(ip); err != nil {
				log.Printf("handlers: rate limiter failed to record an attempt for %q: %v", ip, err)
			}
			jsonError(w, "invalid email or password", http.StatusUnauthorized)
			return
		}
		if err := userModel.ClearAttempts(ip); err != nil {
			log.Printf("handlers: rate limiter failed to clear %q: %v", ip, err)
		}

		raw := make([]byte, 32)
		if _, err := rand.Read(raw); err != nil {
			jsonError(w, "server error", http.StatusInternalServerError)
			return
		}
		token := hex.EncodeToString(raw)

		tokenModel := models.NewMobileTokenModel(readDB, writeDB)
		if err := tokenModel.Issue(mobileHashToken(token), user.ID, time.Now().Add(mobileTokenTTL)); err != nil {
			jsonError(w, "server error", http.StatusInternalServerError)
			return
		}

		jsonOK(w, map[string]any{
			"token": token,
			"user":  map[string]any{"id": user.ID, "name": user.Name, "email": user.Email},
		})
	}
}

// MobileLogoutDELETE handles DELETE /api/v1/auth/logout_token
// Header: Authorization: Bearer <token>
// Always returns 200 — does not reveal whether the token existed.
func MobileLogoutDELETE(readDB, writeDB *sql.DB) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		token := mobileBearerToken(r)
		if token == "" {
			jsonError(w, "unauthorized", http.StatusUnauthorized)
			return
		}
		tokenModel := models.NewMobileTokenModel(readDB, writeDB)
		_ = tokenModel.Revoke(mobileHashToken(token))
		jsonOK(w, map[string]string{"status": "logged out"})
	}
}

// MobileMeGET handles GET /api/v1/auth/me_token
// Header: Authorization: Bearer <token>
// Returns the user associated with the token.
func MobileMeGET(readDB, writeDB *sql.DB, appCache *cache.Cache) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		token := mobileBearerToken(r)
		if token == "" {
			jsonError(w, "unauthorized", http.StatusUnauthorized)
			return
		}
		tokenModel := models.NewMobileTokenModel(readDB, writeDB)
		userID, err := tokenModel.UserID(mobileHashToken(token))
		if err != nil {
			jsonError(w, "unauthorized", http.StatusUnauthorized)
			return
		}
		userModel := models.NewUserModel(readDB, writeDB, appCache)
		user, err := userModel.FindByID(userID)
		if err != nil {
			jsonError(w, "user not found", http.StatusNotFound)
			return
		}
		jsonOK(w, map[string]any{"id": user.ID, "name": user.Name, "email": user.Email})
	}
}

func mobileBearerToken(r *http.Request) string {
	auth := r.Header.Get("Authorization")
	if !strings.HasPrefix(auth, "Bearer ") {
		return ""
	}
	return strings.TrimPrefix(auth, "Bearer ")
}

func mobileHashToken(token string) string {
	h := sha256.Sum256([]byte(token))
	return hex.EncodeToString(h[:])
}
