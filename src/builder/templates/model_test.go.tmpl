func Test{{.PascalName}}Model_Update(t *testing.T) {
	testDB := db.OpenTest(t, {{.Name}}TestSchema)
	m := New{{.PascalName}}Model(testDB, cache.New())
{{- if .Owned}}
	owner, _ := seed{{.PascalName}}Owners(t, testDB)
{{- end}}

{{testDecls .Fields "\t" ""}}	id, err := m.Create({{if .Owned}}owner, {{end}}{{testArgs .Fields ""}})
	if err != nil {
		t.Fatalf("Create: %v", err)
	}
	// Update the existing row — should succeed.
	if err := m.Update(id{{if .Owned}}, owner{{end}}, {{testArgs .Fields ""}}); err != nil {
		t.Fatalf("Update: %v", err)
	}
	// Update a missing row — should report sql.ErrNoRows.
	if err := m.Update(999999{{if .Owned}}, owner{{end}}, {{testArgs .Fields ""}}); err != sql.ErrNoRows {
		t.Errorf("Update(missing): got %v, want sql.ErrNoRows", err)
	}
}

