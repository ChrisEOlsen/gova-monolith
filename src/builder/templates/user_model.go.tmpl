package models

import (
	"database/sql"
	"errors"
	"strings"
	"time"

	"github.com/mattn/go-sqlite3"
	"golang.org/x/crypto/bcrypt"
	"gova/app/cache"
)

// ErrDuplicateEmail is Create's answer to the users.email UNIQUE constraint.
//
// The classification belongs HERE, not in the handler. The handler used to ask
// `strings.Contains(err.Error(), "UNIQUE")`, which is wrong in both directions:
// it reports "that email is taken" for a unique violation on ANY column, and it
// depends on the driver's English error text staying the same forever. A NOT
// NULL column added later, or any other constraint, came back to the user as a
// duplicate-email message about a field they had filled in correctly.
//
// Returning a sentinel from the layer that owns the query also keeps the
// handler free of a sqlite3 import, which is the same reason handlers use model
// methods instead of raw SQL.
var ErrDuplicateEmail = errors.New("an account with that email already exists")

// ErrPasswordTooLong mirrors bcrypt's own 72-byte input limit.
//
// bcrypt.GenerateFromPassword REJECTS a longer password rather than truncating
// it (x/crypto returns ErrPasswordTooLong), so a user who chose a long
// passphrase — the strongest thing they could have done — used to get a generic
// 500 that retrying never fixed. Naming it here lets the handler answer 400
// with something actionable.
var ErrPasswordTooLong = errors.New("password must be at most 72 bytes")

// maxPasswordBytes is bcrypt's hard input limit, in bytes rather than runes:
// the limit is on the byte length, so a passphrase of multi-byte characters
// reaches it sooner than its character count suggests.
const maxPasswordBytes = 72

type User struct {
	ID           int64     `json:"id"`
	Name         string    `json:"name"`
	Email        string    `json:"email"`
	PasswordHash string `json:"-"`
	// models.Time, NOT a bare time.Time.
	//
	// Every create_model output gets this treatment and the wire contract says
	// a model struct must never hold a bare time.Time — so this template broke
	// the contract it ships with, in every generated app. Latent only while
	// nothing serializes a User wholesale: the first endpoint that returns the
	// struct emits RFC3339Nano, which Swift's .iso8601 decoder rejects.
	CreatedAt Time `json:"created_at"`
}

type UserModel struct {
	readDB  *sql.DB
	writeDB *sql.DB
	cache   *cache.Cache
}

func NewUserModel(readDB, writeDB *sql.DB, c *cache.Cache) *UserModel {
	return &UserModel{readDB: readDB, writeDB: writeDB, cache: c}
}

func (m *UserModel) Create(name, email, password string) (int64, error) {
	email = strings.ToLower(email)
	if len(password) > maxPasswordBytes {
		return 0, ErrPasswordTooLong
	}
	hashed, err := bcrypt.GenerateFromPassword([]byte(password), bcrypt.DefaultCost)
	if err != nil {
		return 0, err
	}
	res, err := m.writeDB.Exec(
		"INSERT INTO users (name, email, password_hash) VALUES (?, ?, ?)",
		name, email, string(hashed),
	)
	if err != nil {
		return 0, classifyWriteError(err)
	}
	return res.LastInsertId()
}

// classifyWriteError turns a driver error into a sentinel the handler can
// branch on, by CODE rather than by message text.
func classifyWriteError(err error) error {
	var sqliteErr sqlite3.Error
	if errors.As(err, &sqliteErr) && sqliteErr.ExtendedCode == sqlite3.ErrConstraintUnique {
		return ErrDuplicateEmail
	}
	return err
}

func (m *UserModel) FindByEmail(email string) (*User, error) {
	email = strings.ToLower(email)
	row := m.readDB.QueryRow(
		"SELECT id, name, email, password_hash, created_at FROM users WHERE email = ? LIMIT 1",
		email,
	)
	var u User
	if err := row.Scan(&u.ID, &u.Name, &u.Email, &u.PasswordHash, &u.CreatedAt); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, errors.New("user not found")
		}
		return nil, err
	}
	return &u, nil
}

func (m *UserModel) FindByID(id int64) (*User, error) {
	row := m.readDB.QueryRow(
		"SELECT id, name, email, created_at FROM users WHERE id = ? LIMIT 1",
		id,
	)
	var u User
	if err := row.Scan(&u.ID, &u.Name, &u.Email, &u.CreatedAt); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, errors.New("user not found")
		}
		return nil, err
	}
	return &u, nil
}

func (m *UserModel) IsRateLimited(ip string) (bool, error) {
	var lockedUntil sql.NullTime
	row := m.readDB.QueryRow("SELECT locked_until FROM rate_limits WHERE ip = ?", ip)
	if err := row.Scan(&lockedUntil); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return false, nil
		}
		return false, err
	}
	if lockedUntil.Valid && time.Now().Before(lockedUntil.Time) {
		return true, nil
	}
	return false, nil
}

// RecordFailedAttempt counts one failure against ip's bucket, locking the
// bucket for 15 minutes once it reaches 5 failures within a 15-minute window.
//
// The window is the point. An attempts counter that only ever increments makes
// the limit a LIFETIME quota: five failures at any time in the past leave
// attempts at 5, so the moment a lock lapses the next attempt re-arms it at 6,
// and that IP is capped at one attempt per 15 minutes forever. Behind a shared
// NAT or carrier CGNAT that is every user on the address. So a bucket whose
// last failure predates the window decays — this failure starts a fresh count
// of 1 and clears any stale lock.
//
// Bare column names on the right of DO UPDATE SET read the pre-update row, so
// `updated_at` and `attempts` below are the stored values, not the new ones.
// updated_at and datetime('now', ...) are both SQLite's own
// 'YYYY-MM-DD HH:MM:SS' UTC text, so the comparison is a like-for-like
// lexicographic one.
// It returns the write error rather than discarding it. A caller that cannot
// tell the limiter failed to record an attempt cannot tell that the counter
// will never trip — which silently disables the exact control the caller added
// it for. Every review that flags "the handler ignores the error" is looking at
// the wrong layer: with no return value the handler HAS no error to check.
func (m *UserModel) RecordFailedAttempt(ip string) error {
	_, err := m.writeDB.Exec(`
		INSERT INTO rate_limits (ip, attempts, locked_until, updated_at)
		VALUES (?, 1, NULL, CURRENT_TIMESTAMP)
		ON CONFLICT(ip) DO UPDATE SET
			attempts = CASE WHEN updated_at < datetime('now', '-15 minutes')
				THEN 1 ELSE attempts + 1 END,
			locked_until = CASE
				WHEN updated_at < datetime('now', '-15 minutes') THEN NULL
				WHEN attempts + 1 >= 5 THEN datetime('now', '+15 minutes')
				ELSE locked_until END,
			updated_at = CURRENT_TIMESTAMP
	`, ip)
	return err
}

// ClearAttempts forgets a bucket, and reports whether it managed to.
//
// A failure here is the harmless direction — the bucket keeps counting — but it
// is still a limiter that is not behaving as written, and a silent one is
// indistinguishable from a working one.
func (m *UserModel) ClearAttempts(ip string) error {
	_, err := m.writeDB.Exec("DELETE FROM rate_limits WHERE ip = ?", ip)
	return err
}
