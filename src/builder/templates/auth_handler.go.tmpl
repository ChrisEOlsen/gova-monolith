package handlers

import (
	"database/sql"
	"encoding/json"
	"log"
	"net/http"
	"strings"
	"sync"
	"time"

	"golang.org/x/crypto/bcrypt"
	"gova/app/cache"
	"gova/app/middleware"
	"gova/app/models"
)

// dummyHash lets the not-found path pay the same bcrypt cost as the
// wrong-password path, so response time can't be used to enumerate emails.
var dummyHash = mustDummyHash()

// epochWiring installs the middleware->models epoch bridge exactly once, the
// first time any auth handler that holds the real *sql.DB instances runs.
// It cannot happen in init(): package init has no database handles — they
// arrive with the handler constructors at route-mount time — and this
// package must not import models from middleware, so the lookup closure is
// built here, where both are in scope, and handed to the middleware.
//
// sync.Once because concurrent first requests race harmlessly without it;
// the LAST wiring wins and every wiring is identical anyway.
var epochWiring sync.Once

func wireEpochLookup(readDB, writeDB *sql.DB, appCache *cache.Cache) {
	epochWiring.Do(func() {
		userModel := models.NewUserModel(readDB, writeDB, appCache)
		middleware.EpochLookup = func(r *http.Request, userID int64) int64 {
			return userModel.EpochLookup(r, userID)
		}
	})
}

func mustDummyHash() []byte {
	h, err := bcrypt.GenerateFromPassword([]byte("dummy-password-for-timing"), bcrypt.DefaultCost)
	if err != nil {
		panic(err)
	}
	return h
}

func LoginPOST(readDB, writeDB *sql.DB, appCache *cache.Cache) http.HandlerFunc {
	// The epoch lookup needs the same DB handles the handlers got at mount
	// time; this constructor is the one place both are in scope.
	wireEpochLookup(readDB, writeDB, appCache)
	return func(w http.ResponseWriter, r *http.Request) {
		var body struct {
			Email    string `json:"email"`
			Password string `json:"password"`
		}
		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
			jsonError(w, "invalid request body", http.StatusBadRequest)
			return
		}
		email := strings.TrimSpace(body.Email)
		password := body.Password
		// TWO BUCKETS, AND BOTH ARE LOAD BEARING.
		//
		// ipBucket is the COOKIE login's own address bucket — not a bare
		// clientIP(r), because ClearAttempts deletes by key and sharing a key
		// with the bearer login lets a success on either endpoint erase the
		// other's failures.
		//
		// accountBucket meters the ACCOUNT BEING ATTACKED, and it is what makes
		// the address bucket's clear-on-success safe: without it, four wrong
		// guesses at a victim followed by one correct login to an account the
		// attacker holds resets the counter, forever. It is derived from the
		// SUBMITTED address before any lookup, so it is not an existence
		// oracle. See auth_buckets.go.
		ipBucket := loginBucket(clientIP(r))
		accountBucket := loginEmailBucket(email)

		userModel := models.NewUserModel(readDB, writeDB, appCache)

		// Checked BEFORE the user lookup, so a locked-out answer costs the same
		// and says the same whether or not the address has an account. The
		// 500-vs-429 split for a broken database lives in loginLimited.
		if loginLimited(w, userModel, ipBucket, accountBucket) {
			return
		}

		user, err := userModel.FindByEmail(email)
		if err != nil {
			bcrypt.CompareHashAndPassword(dummyHash, []byte(password))
			// BOTH buckets are counted, the account one included. Counting only
			// attempts against accounts that exist would make "did a 429 ever
			// arrive" a membership test — the enumeration oracle dummyHash is
			// here to prevent, arriving through the limiter instead.
			recordLoginFailure(userModel, ipBucket, accountBucket)
			jsonError(w, "Invalid email or password.", http.StatusUnauthorized)
			return
		}
		if bcrypt.CompareHashAndPassword([]byte(user.PasswordHash), []byte(password)) != nil {
			// BOTH buckets are counted, the account one included. Counting only
			// attempts against accounts that exist would make "did a 429 ever
			// arrive" a membership test — the enumeration oracle dummyHash is
			// here to prevent, arriving through the limiter instead.
			recordLoginFailure(userModel, ipBucket, accountBucket)
			jsonError(w, "Invalid email or password.", http.StatusUnauthorized)
			return
		}

		// Cleared: the caller's address, and the account that has just proved it
		// holds this password. Never a bucket belonging to any other account —
		// that is the whole point of the second key.
		clearLoginAttempts(userModel, ipBucket, accountBucket)
		// Mint the session bound to the user's CURRENT epoch, not the one
		// captured when the user row was read. If a revocation happened
		// between the FindByEmail above and here (a second tab bumping on
		// password change), the cookie must carry the post-bump epoch or
		// the middleware will reject the login that just succeeded.
		middleware.SetSessionWithEpoch(w, user.ID, userModel.EpochLookup(nil, user.ID), 24*time.Hour)
		jsonOK(w, map[string]any{"id": user.ID, "name": user.Name, "email": user.Email})
	}
}

// LogoutAllPOST retires every session the user holds: the epoch bump makes
// all previously issued cookies fail the epoch check server-side, including
// copies on devices that never see this response — which is the difference
// between this and LogoutPOST, whose cookie deletion reaches only the
// browser that made the request. Referenced by scaffolded routes as
// LogoutAllPOST; register the route in api.json as
// POST /api/v1/auth/logout_all if the app wants it exposed.
func LogoutAllPOST(readDB, writeDB *sql.DB, appCache *cache.Cache) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		uid := middleware.UserID(r)
		if uid == 0 {
			jsonError(w, "unauthorized", http.StatusUnauthorized)
			return
		}
		userModel := models.NewUserModel(readDB, writeDB, appCache)
		// A failed bump leaves every stolen cookie valid — log it loudly.
		if err := userModel.BumpSessionEpoch(uid); err != nil {
			log.Printf("handlers: session epoch bump failed for user %d: %v", uid, err)
			jsonError(w, "Something went wrong. Try again.", http.StatusInternalServerError)
			return
		}
		middleware.ClearSession(w)
		jsonOK(w, map[string]string{"status": "logged out everywhere"})
	}
}

func MeGET(readDB, writeDB *sql.DB, appCache *cache.Cache) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		uid := middleware.UserID(r)
		if uid == 0 {
			jsonError(w, "unauthorized", http.StatusUnauthorized)
			return
		}
		userModel := models.NewUserModel(readDB, writeDB, appCache)
		user, err := userModel.FindByID(uid)
		if err != nil {
			jsonError(w, "user not found", http.StatusNotFound)
			return
		}
		jsonOK(w, map[string]any{"id": user.ID, "name": user.Name, "email": user.Email})
	}
}
